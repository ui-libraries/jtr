---
import PageLayout from '../layouts/PageLayout.astro';
import PersonSearch from '../components/PersonSearch.astro';
import RegistrationSearch from '../components/RegistrationSearch.astro';

const pageTitle = "A Just and True Return: Search";

const searchParams =  {};

---

<PageLayout pageTitle={pageTitle}>
  <h1>Search</h1>

    <section class="tabbed-search">

      <div role="tablist" class="tabs" aria-label="Search mode">
        <button id="tab-registration" role="tab" aria-controls="panel-registration" aria-selected="true">Search Registrations</button>
        <button id="tab-person" role="tab" aria-controls="panel-person" aria-selected="false">Search People</button>
      </div>

      <div id="panel-registration" class="tab-panel" role="tabpanel" aria-labelledby="tab-registration" aria-hidden="false">
          <RegistrationSearch params={searchParams} />
      </div>

      <div id="panel-person" class="tab-panel" role="tabpanel" aria-labelledby="tab-person" aria-hidden="true">
          <PersonSearch params={searchParams} />
      </div>

    </section>


     <div id="search-results" class="container-fluid mt-5">
        <h2>Search Results</h2>
        <p>Search functionality coming soon.</p>
      </div>

</PageLayout>


  <script type="module">
    // Tab switching
    const tabs = Array.from(document.querySelectorAll('[role="tab"]'));
    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => {
          const panel = document.getElementById(t.getAttribute('aria-controls'));
          const selected = t === tab;
          t.setAttribute('aria-selected', String(selected));
          if (panel) {
            panel.setAttribute('aria-hidden', String(!selected));
          }
        });
      });
    });

    // Simple handler to demonstrate searching — replace with real API calls
    const resultsContainer = document.getElementById('search-results');

    function showResults(summary, items = []) {
      resultsContainer.innerHTML = `
        <h2>Search Results</h2>
        <p><strong>${summary}</strong></p>
        ${items.length ? '<ul>' + items.map(i => `<li>${i}</li>`).join('') + '</ul>' : '<p>No results found.</p>'}
      `;
    }

    function collectFormData(form) {
      const fd = new FormData(form);
      const obj = {};
      for (const [k, v] of fd.entries()) {
        if (v !== '') obj[k] = v;
      }
      return obj;
    }

    document.getElementById('form-simple').addEventListener('submit', (e) => {
      e.preventDefault();
      const q = collectFormData(e.currentTarget);
      // Placeholder behavior: show the query and pretend we got results
      showResults('Performed simple search', [`Query: ${JSON.stringify(q)}`]);
      // TODO: replace with fetch('/api/search', { method:'POST', body: JSON.stringify(q) })...
    });

    document.getElementById('form-advanced').addEventListener('submit', (e) => {
      e.preventDefault();
      const q = collectFormData(e.currentTarget);
      showResults('Performed advanced search', [`Query: ${JSON.stringify(q)}`]);
    });
  </script>
