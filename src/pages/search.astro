---

export const prerender = false;

import PageLayout from '../layouts/PageLayout.astro';
import PersonSearch from '../components/PersonSearch.astro';
import RegistrationSearch from '../components/RegistrationSearch.astro';
import PersonResult from '../components/person/PersonResult.astro';
import RegistrationResult from '../components/registration/RegistrationResult.astro';

import { runSearch } from '../scripts/functions.js';

// Parse URL search params
const url = (typeof Astro !== 'undefined' && Astro?.request) ? new URL(Astro.request.url) : null;
const paramsObj = url ? Object.fromEntries(url.searchParams.entries()) : {};
const searchParams = Object.keys(paramsObj).length ? paramsObj : {};
// If true, client-side code should run a search on load (placeholder — implement runSearch)
const runSearchOnLoad = Object.keys(searchParams).length > 0;

// If there are search params, run search
let searchResults = null;
let resultCount = 0;
if (runSearchOnLoad) {
  try {
    searchResults = await runSearch(searchParams);
    resultCount = (searchResults && Array.isArray(searchResults)) ? searchResults.length : 0;
  } catch (err) {
    console.log('Search error:', err);
  }
}

const pageTitle = "A Just and True Return: Search";

---

<PageLayout pageTitle={pageTitle}>
  <h1>Search</h1>

    <section class="tabbed-search">

      <div role="tablist" class="tabs" aria-label="Search mode">
        <button id="tab-registration" role="tab" aria-controls="panel-registration" aria-selected={searchParams?.query === 'persons' ? 'false' : 'true'}>Search Registrations</button>
        <button id="tab-person" role="tab" aria-controls="panel-person" aria-selected={searchParams?.query === 'persons' ? 'true' : 'false'}>Search People</button>
      </div>

      <div id="panel-registration" class="tab-panel" role="tabpanel" aria-labelledby="tab-registration" aria-hidden={searchParams?.query === 'persons' ? 'true' : 'false'}>
          <RegistrationSearch params={searchParams?.query === 'full_registration' ? searchParams : {}} />
      </div>

      <div id="panel-person" class="tab-panel" role="tabpanel" aria-labelledby="tab-person" aria-hidden={searchParams?.query === 'persons' ? 'false' : 'true'}>
          <PersonSearch params={searchParams?.query === 'persons' ? searchParams : {}} />
      </div>

    </section>


    {runSearchOnLoad && (
      <div id="search-results" class="container-fluid mt-5">
        <h2>Search Results: {resultCount}</h2>
        
        {searchResults && searchResults.length > 0 ? (
          searchParams?.query === 'persons' ? (
            searchResults.map((person: unknown) => (
              <PersonResult person={person} />
            ))
          ) : (
            searchResults.map((registration: unknown) => (
              <RegistrationResult registration={registration} />
            ))
          )
        ) : (
          <p>No results found.</p>
        )}
      </div>
    )}

</PageLayout>


  <script type="module">
    // Tab switching
    const tabs = Array.from(document.querySelectorAll('[role="tab"]'));
    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => {
          const panel = document.getElementById(t.getAttribute('aria-controls'));
          const selected = t === tab;
          t.setAttribute('aria-selected', String(selected));
          if (panel) {
            panel.setAttribute('aria-hidden', String(!selected));
          }
        });
      });
    });

    function collectFormData(form) {
      const fd = new FormData(form);
      const obj = {};
      for (const [k, v] of fd.entries()) {
        if (v !== '') obj[k] = v;
      }
      return obj;
    }


    // Submit handlers: collect form data and reload page with GET params
    ['form-person', 'form-registration'].forEach((id) => {
      const form = document.getElementById(id);
      if (!form) return;
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const data = collectFormData(e.currentTarget);
        const params = new URLSearchParams();
        Object.entries(data).forEach(([k, v]) => {
          // handle simple values; FormData helper already omits empty values
          params.append(k, String(v));
        });
        const newUrl = location.pathname + (params.toString() ? '?' + params.toString() : '');
        location.href = newUrl;
      });
    });

  </script>
