---
export const prerender = false;

import PageLayout from '../layouts/PageLayout.astro';
import RegistrationResult from '../components/registration/RegistrationResult.astro';

import { getTags, getRegsWithTag } from '../scripts/functions.js';

const url = Astro.url
const idParam = url.searchParams.get('id');
const id = idParam ? idParam : '0';
const tagData = await getTags(id);
const tag = tagData[0];
const registrations = await getRegsWithTag(tag.tag_id);


const pageTitle = "A Just and True Return";

---

<PageLayout pageTitle={pageTitle}>
  <h1>Tag: {tag.name}</h1>


    <p>{tag.description}</p>

    <br />

  <p>{registrations.length} result(s) found.</p>

  {registrations.map((reg: unknown) => (
        <RegistrationResult registration={reg} />
      ))}
          

</PageLayout>