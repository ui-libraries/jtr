---
export const prerender = false;

import PageLayout from '../layouts/PageLayout.astro';
import PersonResult from '../components/person/PersonResult.astro';

import { getTags, getPersonsWithTag } from '../scripts/functions.js';

const url = Astro.url
const idParam = url.searchParams.get('id');
const id = idParam ? idParam : '0';
const tagData = await getTags(id);
const tag = tagData[0];
const persons = await getPersonsWithTag(tag.tag_id);


const pageTitle = "A Just and True Return";

---

<PageLayout pageTitle={pageTitle}>
  <h1>Tag: {tag.name}</h1>

  <p>{persons.length} result(s) found.</p>

  {persons.map((person: unknown) => (
        <PersonResult person={person} />
      ))}
          

</PageLayout>