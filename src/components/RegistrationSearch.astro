---
import TextField from './formElements/TextField.astro';
import SelectField from './formElements/SelectField.astro';
import DateField from './formElements/DateField.astro';
import FormActions from './formElements/FormActions.astro';

import { getCountySelectOptions } from '../scripts/functions.js';

const { params } = Astro.props;
const minDate = new Date('1750-01-01');
const maxDate = new Date('1865-12-31');

const counties = await getCountySelectOptions();
const modernCounties = await getCountySelectOptions('modern');

const defaultDate = new Date(1780, 2, 1); // May 1, 1780 (month is 0-indexed)
---

<form id="form-registration" class="search-form">
    <input type="hidden" name="query" value="full_registration" />

    <div class="form-row">
        <TextField name="registered_name" label="Name of registered person" placeholder="Full or partial name" value={params?.registered_name ?? ''} />
    </div>
    <div class="form-row">
        <TextField name="enslaver_name" label="Name of enslaver" placeholder="Full or partial name" value={params?.enslaver_name ?? ''} />
    </div>
    <div class="form-row">
       <DateField name="after_date" label="After Date" min={minDate} max={maxDate} value={params?.after_date ?? defaultDate} />
       <DateField name="before_date" label="Before Date" min={minDate} max={maxDate} value={params?.before_date ?? defaultDate} />        
    </div>
    <div class="form-row">
        <SelectField name="county" label="Historical County" options={counties} placeholder="Select Historical County" value={params?.county ?? ''} />
        <SelectField name="modern_county" label="Modern County" options={modernCounties} placeholder="Select Modern County" value={params?.modern_county ?? ''} />
    </div>

    <FormActions />
</form>