---
import { getEntry } from 'astro:content';

const { transcript, type } = Astro.props;
const mydoc = await getEntry('docs', transcript);

---

{mydoc && (
<div class="transcript container">
    <div class="row">
        <div class="col-md-8">
            <h3>{type.charAt(0).toUpperCase() + type.slice(1)}</h3>
            <div>
                <div set:html={mydoc.data.body} />
                    
            </div>
        </div>
    </div>

    
    
</div>
)}