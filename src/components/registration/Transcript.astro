---
import { getEntry } from 'astro:content';

const { transcript } = Astro.props;
const mydoc = await getEntry('docs', transcript);

---




<div class="transcript container">
    <div class="row">
        <div class="col-md-8">
            <div>
                {mydoc ? <div set:html={mydoc.data.body} /> : <div>No transcript for this document type.</div>}
                    
            </div>
        </div>
    </div>

    
    
</div>