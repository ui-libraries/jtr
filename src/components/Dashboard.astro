---
import DashboardBigNumber from './DashboardBigNumber.astro';

import { getDashInfo } from '../scripts/functions.js';

const dashInfo = await getDashInfo();
const data = dashInfo.regsPerYear;
---

<div id="overview-dashboard" class="w-100 p-3">
    <div class="d-flex justify-content-between mb-3 bn-row">

        <DashboardBigNumber link="/search#registrations" divId="registration-count" label="Registrations" number={dashInfo.totalRegistrations} />
        <DashboardBigNumber link="/search#persons" divId="people-count" label="People" number={ dashInfo.totalPersons }/>
        <DashboardBigNumber link="#countymap" divId="county-rep-count" label="Counties Represented" number={ dashInfo.totalCounties } />
        <DashboardBigNumber link="/search?query=full_registration&has_transcript=1" divId="transcription-count" label="Registrations Transcribed" number={ dashInfo.transcriptions } />
        
    </div>
      
    <a name="timeline"></a>
   <div id="bars-container">                       
            <div id="registration-bars"></div>
            <p class="dash-label">Registrations by year</p>
       
    </div>
    

    
</div>


<script define:vars={{ data }}>
    //set dimensions and margins for the chart

    document.addEventListener("DOMContentLoaded", () => {
        const margin = {top: 20, right: 20, bottom: 40, left: 20},
            width = 1000 - margin.left - margin.right,
            height = 250 - margin.top - margin.bottom;

       const svgBars = d3.select("#registration-bars")
            .append("svg")
            .attr("width", width + margin.left + margin.right)
            .attr("height", height + margin.top + margin.bottom)
            .append("g")
            .attr("transform", `translate(${margin.left},${margin.top})`);

            // Clean raw data: skip invalid or null year records and keep 1780–1830 only
        const validData = data
            .map((d) => ({ year: Number(d[0]), value: Number(d[1]) }))
            .filter((d) => Number.isInteger(d.year) && !Number.isNaN(d.year) && d.year >= 1780 && d.year <= 1830 && !Number.isNaN(d.value));

        const yearToValue = new Map(validData.map((d) => [d.year, d.value]));
        const yearRange = d3.range(1780, 1831); // inclusive
        const chartData = yearRange.map((y) => ({
            year: y,
            value: yearToValue.has(y) ? yearToValue.get(y) : 0,
        }));

        // Set up scales
        const x = d3.scaleBand()
            .domain(yearRange.map((y) => y))
            .range([0, width])
            .padding(0.1);

        const y = d3.scaleLinear()
            .domain([0, d3.max(chartData, (d) => d.value) || 1])
            .nice()
            .range([height, 0]);

        // Add x-axis with a tick every five years
        svgBars.append("g")
            .attr("transform", `translate(0,${height})`)
            .call(d3.axisBottom(x)
                .tickValues(yearRange.filter((year) => year % 5 === 0)));

        svgBars.selectAll(".tick text")
            .style("font-size", "14px");

        // draw bars (visuals)
        svgBars.selectAll(".bar")
            .data(chartData)
            .enter()
            .append("rect")
            .attr("class", "bar")
            .attr("x", (d) => x(d.year))
            .attr("y", (d) => y(d.value))
            .attr("width", x.bandwidth())
            .attr("height", (d) => height - y(d.value))
            .attr("fill", "#536B76");

        // full-click target per year (including low nonzero bars)
        svgBars.selectAll(".bar-hit")
            .data(chartData)
            .enter()
            .append("rect")
            .attr("class", "bar-hit")
            .attr("x", (d) => x(d.year))
            .attr("y", 0)
            .attr("width", x.bandwidth())
            .attr("height", height)
            .attr("fill", "transparent")
            .style("cursor", "pointer")
            .on("mouseover", function(event, d) {
                d3.select(this.parentNode).selectAll(".bar")
                    .filter((b) => b.year === d.year)
                    .attr("fill", "#6B8595");
            })
            .on("mouseout", function(event, d) {
                d3.select(this.parentNode).selectAll(".bar")
                    .filter((b) => b.year === d.year)
                    .attr("fill", "#536B76");
            })
            .on("click", (event, d) => {
                const year = d.year;
                const startDate = `${year}-01-01`;
                const endDate = `${year}-12-31`;
                const searchUrl = `/search?query=full_registration&after_date=${startDate}&before_date=${endDate}`;
                window.location.href = searchUrl;
            });
    });
            
</script>